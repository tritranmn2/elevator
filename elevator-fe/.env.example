# ==========================================
# ELEVATOR SIMULATOR FRONTEND ENVIRONMENT CONFIG
# ==========================================

# URL gốc của REST API Backend
VITE_API_BASE_URL=http://localhost:3001

# URL kết nối WebSocket Socket.IO Gateway của Backend
VITE_WS_BASE_URL=http://localhost:3001

# Tiêu đề hiển thị ứng dụng
VITE_APP_TITLE=Elevator Simulation Command Center

# Thang máy được chọn mặc định khi khởi động giao diện (1, 2, hoặc 3)
VITE_DEFAULT_SELECTED_ELEVATOR=1
