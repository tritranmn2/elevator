# ==========================================
# ELEVATOR SIMULATOR BACKEND ENVIRONMENT CONFIG
# ==========================================

# Port chạy HTTP Server NestJS
PORT=3001

# Môi trường chạy ứng dụng (development | production | test)
NODE_ENV=development

# Danh sách Origins được phép gọi API (CORS)
# Để '*' cho tất cả hoặc chỉ định: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cấu hình Swagger API Documentation (http://localhost:3001/docs)
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ==========================================
# THÔNG SỐ VẬN HÀNH MÔ PHỎNG THANG MÁY
# ==========================================

# Tổng số tầng của tòa nhà
NUM_FLOORS=10

# Tầng thấp nhất và cao nhất
MIN_FLOOR=1
MAX_FLOOR=10

# Số lượng thang máy hoạt động song song
NUM_ELEVATORS=3

# Thời gian giữ cửa mở tự động (tính bằng số ticks giây)
DEFAULT_DOOR_DWELL_TICKS=5

# Tốc độ nhịp mô phỏng (milliseconds per tick)
SIMULATION_TICK_MS=1000
